DECLARE @YearStart DATE = DATEFROMPARTS(YEAR(GETDATE()) - 1, 1, 1);  -- Jan 1 of last year
DECLARE @YearEnd   DATE = DATEADD(YEAR, 1, @YearStart);              -- Jan 1 of this year

-- Find the Sunday on/before Jan 1 (DATEFIRST-safe using a known Sunday anchor: 1900-01-07)
DECLARE @FirstSunday DATE =
    DATEADD(DAY, - (DATEDIFF(DAY, '19000107', @YearStart) % 7), @YearStart);

WITH Weeks AS (
    SELECT
        @FirstSunday AS week_start,
        DATEADD(DAY, 6, @FirstSunday) AS week_end
    UNION ALL
    SELECT
        DATEADD(DAY, 7, week_start),
        DATEADD(DAY, 13, week_start)
    FROM Weeks
    WHERE DATEADD(DAY, 7, week_start) < @YearEnd
)
SELECT
    w.week_start,
    w.week_end,
    COUNT(v.service_order_key) AS total_services,
    SUM(CASE WHEN v.subtotal = 0 THEN 1 ELSE 0 END) AS zero_subtotal_services,
    CAST(
        CASE
            WHEN COUNT(v.service_order_key) = 0 THEN 0.0
            ELSE
                CAST(SUM(CASE WHEN v.subtotal = 0 THEN 1 ELSE 0 END) AS FLOAT)
                / COUNT(v.service_order_key)
        END
    AS DECIMAL(6,4)) AS pct_zero_subtotal
FROM Weeks w
LEFT JOIN dbo.vr_311 v
    ON v.work_dt >= w.week_start
   AND v.work_dt <  DATEADD(DAY, 7, w.week_start)   -- Sunday inclusive, next Sunday exclusive
   AND v.work_dt >= @YearStart
   AND v.work_dt <  @YearEnd                         -- only count services that occurred in last year
GROUP BY
    w.week_start, w.week_end
ORDER BY
    w.week_start
OPTION (MAXRECURSION 400);
